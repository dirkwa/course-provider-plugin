{
  "name": "@signalk/course-provider-wasm",
  "version": "0.1.0",
  "description": "Course Data Provider WASM - calculates navigation course values",
  "keywords": [
    "signalk-node-server-plugin",
    "signalk-wasm-plugin",
    "signalk",
    "wasm",
    "course",
    "navigation",
    "calcValues"
  ],
  "wasmManifest": "build/plugin.wasm",
  "wasmCapabilities": {
    "storage": "vfs-only",
    "dataRead": true,
    "dataWrite": true,
    "httpEndpoints": true
  },
  "repository": {
    "url": "https://github.com/SignalK/course-provider-plugin",
    "type": "git"
  },
  "author": "AdrianP",
  "contributors": [
    {
      "name": "panaaj@hotmail.com"
    },
    {
      "name": "Signal K WASM Team"
    }
  ],
  "license": "Apache-2.0",
  "scripts": {
    "asbuild:debug": "asc assembly/index.ts --target debug --outFile build/plugin.debug.wasm",
    "asbuild:release": "asc assembly/index.ts --target release --outFile build/plugin.wasm",
    "asbuild": "npm run asbuild:release",
    "build": "npm run asbuild",
    "clean": "rimraf build/"
  },
  "devDependencies": {
    "assemblyscript": "^0.27.0",
    "rimraf": "^6.0.1"
  },
  "dependencies": {
    "signalk-assemblyscript-plugin-sdk": "^0.1.3"
  }
}
